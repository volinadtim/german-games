[resource]
script = ExtResource("1_g6awu")
id = "pistol"
order = 44
name = "Пистолет"
desc = "Старый обшарпанный пистолет. ПКМ держать — от бедра, ПКМ клик — прицел, с ПКМ ЛКМ — выстрел, без — удар рукоятью. Два пистолета стреляют по очереди. [R] — сменить магазин, [Enter] (держать) — вынуть магазин. Магазин можно перетащить на пистолет. Слоты модулей: прицел, дуло, приклад, цевьё (по умолчанию — мушка, без коллиматора). Прочность — 60 выстрелов, чинится ремкомплектом огнестрела."
icon = "pistol"
color = Color(0.24, 0.24, 0.23, 1)
dur = 9
props = {
"gun": true,
"rounds": true,
"weapon": true
}
