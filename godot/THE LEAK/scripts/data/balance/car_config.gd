@tool
class_name CarConfig
extends Resource
## Машина (scripts/car/car_model.gd и наследники). Файл — data/balance/car.tres.

@export_group("Скорость и разгон")
## Предел скорости вперёд, м/с.
@export_range(0.0, 60.0, 0.5) var max_forward := 13.0
## Предел скорости назад, м/с.
@export_range(0.0, 30.0, 0.5) var max_reverse := 4.0
## Разгон, м/с².
@export_range(0.0, 50.0, 0.1) var accel := 4.2
## Торможение, м/с².
@export_range(0.0, 100.0, 0.5) var brake := 15.0
## Накат без газа (замедление), м/с².
@export_range(0.0, 20.0, 0.1) var roll := 1.6
## Расход бензина за секунду газа (доля бака): 0.0033 — полный бак ~5 мин газа.
@export var fuel_use := 0.0033333333333333335

@export_group("Руль и занос")
## Поворот руля (скорость поворота колёс).
@export_range(0.0, 10.0, 0.05) var turn := 1.25
## Колёсная база (передняя ось — задняя), м.
@export var wheelbase := 2.44
## Предел бокового сцепления шин, м/с²: в обычной езде не скользит.
@export_range(0.0, 100.0, 0.5) var grip_lateral := 24.0
## Сцепление с ручником: зад сорван — машину несёт боком, м/с².
@export_range(0.0, 100.0, 0.1) var grip_lateral_handbrake := 2.6
## Торможение ручником без газа.
@export_range(0.0, 20.0, 0.05) var handbrake_decel := 0.8
## Ручник + газ: в дрифте скорость почти держится.
@export_range(0.0, 20.0, 0.05) var handbrake_decel_gas := 0.3
## Предел скорости вращения в заносе, рад/с (пончики).
@export_range(0.0, 20.0, 0.1) var drift_yaw := 3.6

@export_group("Бернаут и быстрый старт")
## За сколько секунд колёса раскручиваются до предела, с.
@export_range(0.0, 10.0, 0.05) var burn_time := 1.1
## Добавка к видимой скорости задних колёс при бернауте, м/с.
@export var burn_spin := 13.0
## До какой скорости бернаут считается «с места», м/с.
@export var burn_speed := 1.3
## Сколько длится рывок быстрого старта, с.
@export_range(0.0, 10.0, 0.05) var launch_time := 1.3
## Во сколько раз сильнее разгон на рывке (сверх обычного).
@export_range(0.0, 10.0, 0.05) var launch_accel := 2.2

@export_group("Урон и прочность")
## Прочность машины.
@export_range(0.0, 1000.0, 1.0) var max_hp := 160.0
## Сколько прочности возвращает один удар молотком (доля от максимума).
@export_range(0.0, 1.0, 0.01) var repair := 0.34
## С какой скорости удар о препятствие ранит сидящих, м/с.
@export var crash_min := 5.0
## Урон сидящим = (скорость − порог) × это число.
@export var crash_dmg := 3.0
## Наезд на врага: сидящие теряют (скорость × это число).
@export var ram_self := 0.35
## С какой относительной скорости удар машиной ранит моба, м/с.
@export var hit_min := 3.0
## Урон мобу = относительная скорость × это число.
@export var hit_dmg := 7.0
## Удар по машине ближе этого к голове сидящего задевает и его, м.
@export var seat_hit_radius := 1.5
## Какая доля урона достаётся сидящему рядом с местом удара.
@export_range(0.0, 1.0, 0.01) var seat_hit_share := 0.4

@export_group("Посадка и обзор")
## Через сколько секунд после посадки включается стартер.
@export var crank_at := 0.5
## Пересадка с пассажирского за руль, с.
@export var switch_time := 0.75
## Насколько можно отвернуться от «вперёд по машине», рад.
@export var look_max := 2.3
## Время высовывания в окно, с.
@export var lean_time := 0.35
## На сколько глаза уходят в окно, м.
@export var lean_out := 0.44

@export_group("Модель (не баланс)")
## Радиус колеса, м.
@export var wheel_r := 0.29
## Спущенное колесо (номер: 3 — заднее правое).
@export var flat_wheel := 3
## Насколько осел угол со спущенным колесом, м.
@export var flat_sag := 0.08
## Глаза на местах (водитель, пассажир, задние), в координатах машины.
@export var seat_eye: Array[Vector3] = []
## Таз на местах.
@export var seat_hip: Array[Vector3] = []
## Двери: [сторона, петля z, длина]; дверь i — у места i.
@export var doors: Array = []
## Точки выхода из машины для мест.
@export var exits: Array[Vector3] = []
## Соседние места (рядом и спереди/сзади) для пересадки.
@export var next_seats: Array = []
## На сколько радиан открывается дверь.
@export var door_open := 1.15
## На сколько радиан поднимается крышка багажника.
@export var trunk_open := 1.15
