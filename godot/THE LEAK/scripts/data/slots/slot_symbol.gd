@tool
class_name SlotSymbol
extends Resource
## Символ автомата (паттерн Type Object): один ресурс на символ, всё про символ — в одном месте.
## Список символов автомата — поле «Символы» у конфига автомата; порядок в списке = порядок на доске выплат.

## Ключ символа в коде и в сейвах. Не менять у существующих символов (например "grape" — это арбуз).
@export var id := ""
## Название для игрока (магазин, табличка баффов).
@export var title := ""
## Шанс выпасть в клетке — вес относительно остальных символов автомата (чем больше, тем чаще).
## Сумма весов не обязана быть 100.
@export_range(0.0, 100.0, 0.1, "or_greater") var weight := 10.0
## Выплата за 3 одинаковых в линию (монет, у автоматов со ставкой — ×ставка). 0 — не платит.
@export_range(0, 10000, 1, "or_greater") var pay_3 := 0
