@tool
class_name KillboxSymbol
extends SlotSymbol
## Символ автомата KILLBOX: выплаты за 3/4/5 в линию, пара, баффы магазина бункера.

@export_group("Выплаты")
## Выплата за 4 одинаковых в линию, монет. 0 — не платит.
@export_range(0, 10000, 1, "or_greater") var pay_4 := 0
## Выплата за 5 одинаковых в линию, монет. 0 — не платит.
@export_range(0, 10000, 1, "or_greater") var pay_5 := 0
## Пара одинаковых соседних в ряду (только на маленьком окне — см. «Выплаты» у автомата). 0 — пара не платит.
@export_range(0, 1000, 1, "or_greater") var pay_pair := 0

@export_group("Гарант (магазин)")
## Гарант: после каждой крутки k штук этого символа встают в случайные открытые клетки.
## Сколько круток действует. 0 — гарант этого символа не продаётся.
@export_range(0, 100, 1, "or_greater") var guarantee_spins := 0
## Цены гаранта, монет: [за ×1, за ×2, за ×3] (сколько штук символа за крутку). Сколько цен — столько вариантов в магазине.
## Подобраны так, чтобы прибавка выигрыша за все крутки была меньше цены.
@export var guarantee_prices: Array[int] = []

@export_group("Шанс комбинации (магазин)")
## Шанс комбинации: символ чаще «липнет» к соседу слева (липкость «С бустом» у автомата вместо обычной).
## Сколько круток действует. 0 — не продаётся.
@export_range(0, 100, 1, "or_greater") var boost_spins := 0
## Цена шанса комбинации, монет.
@export_range(0, 10000, 1, "or_greater") var boost_price := 0
