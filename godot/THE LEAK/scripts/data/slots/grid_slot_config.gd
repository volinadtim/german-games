@tool
class_name GridSlotConfig
extends SlotConfig
## Общее у автоматов с полем 3×3 и ставкой (CASHY BOX, КЛЁВ, РАДИАЦИЯ): ставки, линии, время крутки, экран.

@export_group("Цены и крутки")
## Цена крутки при ставке ×1, монет. Крутка стоит цена × ставка, денежные выигрыши тоже × ставка.
@export_range(0, 10000, 1, "or_greater") var spin_price := 20
## Ставки по кругу (кнопка «СТАВКА» на полке слева).
@export var bets: Array[int] = [1, 2, 3, 5, 10]

@export_group("Выплаты")
## Линии поля: номера клеток (барабан×3 + ряд: 0 1 2 — первый барабан сверху вниз, 3 4 5 — второй…).
## Три одинаковых символа на линии — выплата символа × ставка.
@export var lines: Array[PackedInt32Array] = []

@export_group("Время крутки")
## Сколько крутится первый барабан, секунд.
@export_range(0.0, 5.0, 0.01) var spin_time := 0.9
## Через сколько секунд останавливается каждый следующий барабан.
@export_range(0.0, 5.0, 0.01) var step_time := 0.3

@export_group("Модель и вид (не баланс)")
## Экран: ширина, пикселей.
@export var screen_w := 480
## Экран: высота, пикселей.
@export var screen_h := 450
## Поле на экране: отступ слева до первого барабана, пикселей.
@export var field_x0 := 26.0
## Ширина клетки, пикселей.
@export var cell_w := 136.0
## Промежуток между барабанами, пикселей.
@export var cell_gap := 10.0
## Верх поля (над ним — полоса названия), пикселей.
@export var field_top := 44.0
## Высота клетки, пикселей.
@export var cell_h := 108.0


## [[клетки линии], …] — как в прежней таблице.
func lines_table() -> Array:
	var out: Array = []
	for l in lines:
		out.append(Array(l))
	return out
